{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint resources/js",
        "test:front": "vitest run",
        "test:front:watch": "vitest",
        "test:front:coverage": "vitest run --coverage",
        "test:e2e": "node scripts/testing/run-e2e.mjs",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:prepare": "node scripts/testing/run-e2e.mjs --prepare-only",
        "test": "npm run test:front",
        "check": "npm run lint && npm run test:front && npm run build"
    },
    "dependencies": {
        "@hello-pangea/dnd": "^18.0.1",
        "bootstrap-icons": "^1.13.1",
        "html2canvas": "^1.4.1",
        "html2pdf.js": "^0.14.0",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.8",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-router-dom": "^7.9.1",
        "sweetalert2": "^11.23.0",
        "web-vitals": "^2.1.4"
    },
    "devDependencies": {
        "@eslint/js": "^9.35.0",
        "@playwright/test": "^1.55.0",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.8.0",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@vitejs/plugin-react": "^5.0.4",
        "@vitest/coverage-v8": "^3.2.4",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^9.35.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.20",
        "globals": "^16.3.0",
        "jsdom": "^26.1.0",
        "laravel-vite-plugin": "^2.0.0",
        "msw": "^2.10.5",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.4",
        "vitest": "^3.2.4"
    }
}
